# Scripture Theory environment variables
# Copy to .env.local and fill in what you need. Every value is OPTIONAL —
# with none set, the platform runs fully on-device (auth/cloud UI stays
# hidden, intake/ESV degrade to graceful "not configured" states).

# ─── Supabase — cloud sync, prayer wall, admin queues ─────────────
# 1. Create a free project at https://supabase.com
# 2. Settings → API → copy the URL and anon key here.
# 3. In the SQL editor, run each file in supabase/migrations/ in order.
# 4. Auth → Providers → enable Email (magic link); optionally Google/Apple.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Canonical site URL (sitemaps, robots, OG cards, feeds) ───────
# e.g. https://scripture-theory.vercel.app  (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# ─── ESV translation (server-only) ────────────────────────────────
# Create an eligible non-commercial API application at https://api.esv.org.
# The token enables the ESV in the reader and must never use NEXT_PUBLIC_.
# Licensed ESV text is fetched live, rate-limited, and never stored offline.
ESV_API_KEY=

# ─── Giving links (client-visible) ────────────────────────────────
# External Stripe / Ko-fi / Patreon URLs surfaced on /give.
NEXT_PUBLIC_GIVE_ONCE_URL=
NEXT_PUBLIC_GIVE_MONTHLY_URL=

# ─── Intake email (server-only) — pastor claims & testimonies ─────
# Uses Resend (https://resend.com). Without RESEND_API_KEY the /api/intake
# endpoint validates and returns a "pilot mode" response instead of sending.
RESEND_API_KEY=
INTAKE_FROM=Scripture Theory <noreply@your-domain>
INTAKE_CLAIM_TO=onboarding@your-domain
INTAKE_TESTIMONY_TO=testimonies@your-domain
