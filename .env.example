# Scripture Theory environment variables
# Copy to .env.local and fill in.

# ─── Optional: Supabase cloud sync ────────────────────────────────
# Leave blank to keep the platform 100% on-device (the Sign-in UI will
# stay hidden until these are set).
#
# 1. Create a free project at https://supabase.com
# 2. Settings → API → copy the URL and anon key here.
# 3. In the SQL editor, run supabase/migrations/0001_profiles.sql
# 4. Auth → Providers → enable Email (magic link). Optionally enable
#    Google and Apple for one-tap sign-in.
# 5. Redeploy.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
