# The neural-voice feature (kokoro-js → @huggingface/transformers) runs entirely
# in the browser via onnxruntime-web. Its transitive dependency
# `onnxruntime-node` tries to download native (CUDA) binaries on install — we
# never use the Node runtime, and that download can 403 behind proxies or waste
# minutes on CI. Skipping it makes installs deterministic. The browser wasm
# runtime we actually use is self-hosted by scripts/copy-ort-runtime.mjs.
onnxruntime-node-install-cuda=skip
